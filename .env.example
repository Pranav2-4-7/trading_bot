# GitHub Personal Access Token (for auto git push without GUI popups)
# Generate from GitHub -> Settings -> Developer Settings -> Personal access tokens (Tokens classic) -> repo scope
GITHUB_PAT=

# Reddit API Credentials (optional for social sentiment scraper)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=TradingBotRetailSentiment/1.0

# Twitter (X) API Bearer Token (optional for social sentiment scraper)
TWITTER_BEARER_TOKEN=

# Gemini API Key (optional for LLM daily sentiment/report analysis)
GEMINI_API_KEY=
